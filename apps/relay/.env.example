# PACT Cloud Relay Configuration
PORT=8787

# Deepgram Streaming STT (16kHz linear16, endpointing=350, diarize=true)
DEEPGRAM_API_KEY=

# Supabase Cloud (PostgreSQL + pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude via Yantra AI (https://apikeys.in) — OpenAI-compatible gateway, takes priority when set
YANTRA_API_KEY=
YANTRA_BASE_URL=https://api.aitklabs.in/v1
# Legacy providers (used only if YANTRA_API_KEY is empty)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Cloud LLM model + embeddings (Yantra model IDs: see https://api.aitklabs.in/v1/models)
CLAUDE_MODEL=anthropic/claude-haiku-5-5
EMBEDDING_MODEL=openai/text-embedding-3-small

# Notion Integration (Context Indexer & Pact Ledger)
NOTION_API_KEY=
NOTION_PACT_LEDGER_DB_ID=

# Official Telegram Bot API

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
